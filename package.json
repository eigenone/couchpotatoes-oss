{
  "name": "couchpotatoes",
  "private": true,
  "description": "Open source game engine, UX toolkit and framework for digital board and card games",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine/tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
